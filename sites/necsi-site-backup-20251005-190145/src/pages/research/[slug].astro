---
import { getResearchBySlug, getResearchList } from '../../lib/content';
import { mdToHtml } from '../../lib/markdown';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const items = await getResearchList();
  return items.map((it) => ({ params: { slug: it.slug } }));
}

const { slug } = Astro.params;
const doc = await getResearchBySlug(slug!);
---

<style is:global>
  header {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-color: transparent !important;
  }
  header a {
    color: white !important;
  }
  header a:hover {
    color: #e2e8f0 !important; /* slate-200 */
  }
</style>

<BaseLayout title={`${doc.title} — NECSI`}>
  <!-- Full-bleed banner behind the sticky nav (nav is translucent) -->
  <section class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen -mt-24 -mb-px">
    <div class="relative">
      {doc.hero_image && (
        <img src={doc.hero_image} alt="" class="absolute inset-0 h-full w-full object-cover" />
      )}
      <div class={`relative ${doc.hero_image ? 'bg-transparent' : 'bg-gradient-to-b from-slate-800 to-slate-700'}`}>
        <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 sm:py-28">
          <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-white">{doc.title}</h1>
          {doc.subtitle && (
            <p class="mt-3 text-slate-200 text-lg max-w-3xl">{doc.subtitle}</p>
          )}
        </div>
      </div>
    </div>
  </section>
  <div class="mt-4 mb-6">
    <a href="/research" class="text-sky-700 hover:underline">← Back to Research</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-8">
      <section class="prose prose-slate max-w-none">
        <div set:html={mdToHtml(doc.narrative_md)} />
      </section>
    </div>
    <aside class="lg:col-span-4 lg:pt-2">
      {doc.sections && (
        <nav class="space-y-6">
          {doc.sections.introductions?.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Introductions</h3>
              <ul class="space-y-2">
                {doc.sections.introductions.map((it:any) => (
                  <li><a class="text-sky-700 hover:underline" href={it.url}>{it.title}</a></li>
                ))}
              </ul>
            </div>
          )}
          {doc.sections.research?.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Research</h3>
              <ul class="space-y-2">
                {doc.sections.research.map((it:any) => (
                  <li><a class="text-sky-700 hover:underline" href={it.url}>{it.title}</a></li>
                ))}
              </ul>
            </div>
          )}
          {doc.sections.policy_statements?.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Policy Statements</h3>
              <ul class="space-y-2">
                {doc.sections.policy_statements.map((it:any) => (
                  <li class="text-sm">
                    <a class="text-sky-700 hover:underline" href={it.url}>{it.title}</a>
                    {it.authors && (<span> — {it.authors}</span>)}
                    {it.outlet && (<span>, {it.outlet}</span>)}
                    {it.date && (<span> ({it.date})</span>)}
                    {it.asset && (<span> · <a class="text-sky-700 hover:underline" href={it.asset}>download</a></span>)}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {doc.sections.media_coverage?.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-2">Media Coverage</h3>
              <ul class="space-y-3">
                {doc.sections.media_coverage.map((it:any) => (
                  <li class="flex gap-3 items-center">
                    {it.image && (<img class="rounded border" src={it.image} alt={it.title} width="80" />)}
                    <div>
                      <a class="text-sky-700 hover:underline" href={it.url}>{it.title}</a>
                      {it.outlet && (<div class="text-gray-600 text-xs">{it.outlet}</div>)}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </nav>
      )}
    </aside>
  </div>
</BaseLayout>
