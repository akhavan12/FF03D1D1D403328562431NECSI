---
import { getResearchList } from '../../lib/content';
const research = await getResearchList();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Research — NECSI</title>
  </head>
  <body style="font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif; padding: 2rem; max-width: 900px; margin: 0 auto;">
    <h1>Research</h1>
    <ul>
      {research.map(r => (
        <li style="margin: 1rem 0;">
          <a href={`/research/${r.slug}`} style="font-weight:600;">{r.title}</a>
          {r.subtitle && (<div style="color:#555; font-size:0.95rem;">{r.subtitle}</div>)}
          {r.summary && (<div style="color:#333;">{r.summary}</div>)}
        </li>
      ))}
    </ul>
  </body>
</html>
