---
import { getResearchList } from '../lib/content';
const research = await getResearchList();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NECSI</title>
  </head>
  <body style="font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif; padding: 2rem;">
    <h1>NECSI — Research</h1>
    <p><a href="/research">Browse research</a></p>
    <ul>
      {research.map(r => (
        <li><a href={`/research/${r.slug}`}>{r.title}</a> — {r.summary}</li>
      ))}
    </ul>
  </body>
</html>
