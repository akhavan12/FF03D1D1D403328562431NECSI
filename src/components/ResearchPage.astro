---
import Layout from './Layout.astro';

interface Props {
  hero: {
    title?: string;
    subtitle?: string;
    image?: string;
  } | null | undefined;
  contentBlocks: any[];
}

const { hero, contentBlocks } = Astro.props;

// Function to normalize image paths
function normalize(path: string): string {
  if (!path) return '';
  if (path.startsWith('/')) return path;
  if (path.startsWith('../')) return path.replace('../', '/');
  return `/${path}`;
}

// Get the main content and separate sections
const mainContent = contentBlocks.find(block => 
  block.heading && 
  !block.heading.includes('Get Involved') && 
  !block.heading.includes('Research:') && 
  !block.heading.includes('News Coverage') &&
  !block.heading.includes('Longevity') &&
  !block.heading.includes('Altruism') &&
  !block.heading.includes('Speciation') &&
  !block.heading.includes('The Gene Centered View') &&
  !block.heading.includes('Genealogy') &&
  !block.heading.includes('Population Dynamics')
);

const getInvolved = contentBlocks.find(block => block.heading === 'Get Involved');

// Group research content by sections
const researchSections = contentBlocks.filter(block => 
  block.heading && 
  (block.heading.includes('Longevity') ||
   block.heading.includes('Altruism') ||
   block.heading.includes('Speciation') ||
   block.heading.includes('The Gene Centered View') ||
   block.heading.includes('Genealogy') ||
   block.heading.includes('Population Dynamics') ||
   (block.text && block.text.length > 100))
);

// Get references (text content that looks like citations)
const references = contentBlocks.filter(block => 
  block.text && 
  block.text.length > 100 && 
  (block.text.includes('doi:') || 
   block.text.includes('Nature') || 
   block.text.includes('Physical Review') ||
   block.text.includes('PNAS') ||
   block.text.includes('NECSI'))
);
---

<section class="research-page">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">{hero?.title || 'Research'}</h1>
    </div>
  </section>

  <!-- Main Content -->
  <section class="main-content">
    <div class="content-container">
      
      <!-- First Row: Full-width content -->
      {mainContent && mainContent.heading && (
        <div class="content-section main-text">
          <p class="main-content-text">{mainContent.heading}</p>
        </div>
      )}

      <!-- Second Row: Two columns -->
      <div class="two-column-row">
        <!-- Left Column: Main Content -->
        <div class="left-column">
          <div class="content-section">
            {researchSections.map((section, index) => (
              <div class="research-section">
                <h2 class="section-heading">{section.heading}</h2>
                {section.text && (
                  <div class="section-text" set:html={section.text.replace(/\n/g, '<br>')} />
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Right Column: Get Involved -->
        <div class="right-column">
          {getInvolved && (
            <div class="content-section get-involved">
              <h2 class="section-heading">Get Involved</h2>
            </div>
          )}
        </div>
      </div>

      <!-- Third Row: Two columns -->
      <div class="two-column-row">
        <!-- Left Column: Research Information -->
        <div class="left-column">
          <div class="content-section research-info">
            <h2 class="section-heading">Research Information</h2>
            <div class="research-details">
              {researchSections.slice(0, 3).map((section, index) => (
                <div class="research-item">
                  <h3 class="research-title">{section.heading}</h3>
                  <p class="research-description">
                    {section.text ? section.text.substring(0, 200) + '...' : ''}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Column: References -->
        <div class="right-column">
          <div class="content-section references">
            <h2 class="section-heading">References</h2>
            <div class="references-list">
              {references.map((ref, index) => (
                <div class="reference-item">
                  <div class="reference-text" set:html={ref.text.replace(/\n/g, '<br>')} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</section>

<style>
  .research-page {
    min-height: 100vh;
    background: #ffffff;
    color: #333333;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    background-image: url('/assets/images/blue-background2.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .hero-section::before {
    content: '';
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(52, 106, 121, .25);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    color: white;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Main Content */
  .main-content {
    padding: 2rem 0 4rem 0;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .content-section {
    margin-bottom: 2.5rem;
  }

  .main-text {
    margin-bottom: 3rem;
  }

  .main-content-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333333;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Two Column Layout */
  .two-column-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .left-column,
  .right-column {
    display: flex;
    flex-direction: column;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 600;
    color: #333333;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .research-section {
    margin-bottom: 2rem;
  }

  .research-section .section-heading {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .section-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #333333;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Research Information */
  .research-info {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
  }

  .research-item {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e9ecef;
  }

  .research-item:last-child {
    border-bottom: none;
  }

  .research-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333333;
    margin-bottom: 0.5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .research-description {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #666666;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* References */
  .references {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
  }

  .reference-item {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e9ecef;
  }

  .reference-item:last-child {
    border-bottom: none;
  }

  .reference-text {
    font-size: 0.9rem;
    line-height: 1.4;
    color: #333333;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Get Involved */
  .get-involved {
    background: #e3f2fd;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .two-column-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-section {
      min-height: 250px;
    }

    .content-container {
      padding: 0 1rem;
    }

    .main-content {
      padding: 1.5rem 0 3rem 0;
    }

    .content-section {
      margin-bottom: 2rem;
    }

    .main-text {
      margin-bottom: 2rem;
    }

    .section-heading {
      font-size: 1.3rem;
    }

    .research-section .section-heading {
      font-size: 1.1rem;
    }

    .research-info,
    .references,
    .get-involved {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      min-height: 200px;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .main-content {
      padding: 1rem 0 2rem 0;
    }

    .research-info,
    .references,
    .get-involved {
      padding: 1rem;
    }
  }
</style>
