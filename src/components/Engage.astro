---
interface Props {
  hero: {
    title?: string;
    subtitle?: string;
    image?: string;
  } | null | undefined;
  contentBlocks: Array<{
    heading: string;
    text?: string;
  }>;
}

const { hero, contentBlocks } = Astro.props;

// Helper function to normalize image paths
function normalize(path: string | null | undefined): string {
  if (!path) return '';
  return path.startsWith('../') ? path.replace('../', '/') : path;
}

// Group content blocks by type
const learnMoreBlocks = contentBlocks.filter(block => 
  block.heading === 'Online Resources' || 
  block.heading === 'Recent Papers' || 
  block.heading === 'Research Archives'
);

const socialBlocks = contentBlocks.filter(block => 
  block.heading === 'Twitter' || 
  block.heading === 'LinkedIn' || 
  block.heading === 'Medium' ||
  block.heading === 'Facebook: NECSI / Social Complexity'
);

const actionBlocks = contentBlocks.filter(block => 
  block.heading === 'Make a donation .' || 
  block.heading === 'Become a member .' || 
  block.heading === 'Join our team.'
);
---

<section class="engage-page">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-icon">
        <svg width="80" height="80" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Four stylized human head silhouettes in a circle -->
          <circle cx="50" cy="20" r="12" fill="white"/>
          <circle cx="50" cy="80" r="12" fill="white"/>
          <circle cx="20" cy="50" r="12" fill="white"/>
          <circle cx="80" cy="50" r="12" fill="white"/>
          <!-- Connecting lines -->
          <path d="M50 32 L50 68 M38 50 L62 50" stroke="white" stroke-width="2" opacity="0.3"/>
        </svg>
      </div>
      <h1 class="hero-title">ENGAGE</h1>
    </div>
  </section>

  <!-- Main Content -->
  <section class="main-content">
    <div class="container">
      <div class="content-grid">
        
        <!-- Left Column -->
        <div class="left-column">
          
          <!-- Learn More Section -->
          <div class="content-section">
            <h2 class="section-heading">Learn more about what we do</h2>
            <ul class="link-list">
              {learnMoreBlocks.map((block) => (
                <li><a href="#" class="content-link">{block.heading}</a></li>
              ))}
            </ul>
          </div>

          <!-- Social Media Section -->
          <div class="content-section">
            <h2 class="section-heading">Join the conversation on:</h2>
            <ul class="link-list">
              {socialBlocks.map((block) => (
                <li><a href="#" class="content-link">{block.heading}</a></li>
              ))}
            </ul>
          </div>

          <!-- Action Items -->
          <div class="action-section">
            {actionBlocks.map((block) => (
              <div class="action-item">
                <span class="action-text">{block.heading.replace('.', '')}</span>
                <span class="action-highlight">.</span>
              </div>
            ))}
          </div>

        </div>

        <!-- Right Column - Newsletter Form -->
        <div class="right-column">
          <div class="newsletter-section">
            <h2 class="section-heading">Sign up for NECSI's newsletter below.</h2>
            <p class="newsletter-instruction">Please set your spam filter to allow e-mail from programs@necsi.edu.</p>
            
            <form class="newsletter-form">
              <div class="form-row">
                <input type="text" placeholder="First Name" class="form-input" />
                <input type="text" placeholder="Last Name" class="form-input" />
              </div>
              
              <input type="email" placeholder="Email (required)" class="form-input form-input-full" required />
              
              <div class="form-section">
                <p class="form-question">What NECSI topics are you interested in hearing about?</p>
                <div class="checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" class="checkbox-input" />
                    <span class="checkbox-text">Research and News</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" class="checkbox-input" />
                    <span class="checkbox-text">Educational Programs</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" class="checkbox-input" />
                    <span class="checkbox-text">International Conference on Complex Systems</span>
                  </label>
                </div>
              </div>
              
              <button type="submit" class="submit-button">SUBMIT</button>
              
              <p class="privacy-text">NECSI protects your information: We do not sell, trade, or otherwise transfer to outside parties your personally identifiable information.</p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
</section>

<style>
  .engage-page {
    background: #0c1b3a;
    color: white;
    min-height: 100vh;
    background-image: url('/assets/images/blue-background2.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  .hero-section {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 700;
    color: white;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .main-content {
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .left-column {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .content-section {
    margin-bottom: 2rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin: 0 0 1.5rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link-list li {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .link-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: white;
  }

  .content-link {
    color: white;
    text-decoration: underline;
    font-size: 1rem;
    line-height: 1.6;
    transition: opacity 0.3s ease;
  }

  .content-link:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .action-section {
    margin-top: 2rem;
  }

  .action-item {
    margin-bottom: 1rem;
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .action-text {
    color: white;
  }

  .action-highlight {
    color: white;
    text-decoration: underline;
    font-weight: 600;
  }

  /* Newsletter Form Styles */
  .newsletter-section {
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .newsletter-instruction {
    color: white;
    font-size: 0.9rem;
    margin: 0 0 2rem 0;
    opacity: 0.8;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-input {
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    background: white;
    color: #333;
  }

  .form-input:focus {
    outline: none;
    border-color: #3498db;
    box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
  }

  .form-input-full {
    width: 100%;
  }

  .form-section {
    margin: 1rem 0;
  }

  .form-question {
    color: white;
    font-size: 0.9rem;
    margin: 0 0 1rem 0;
  }

  .checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .checkbox-input {
    width: 18px;
    height: 18px;
    border: 2px solid white;
    background: transparent;
    border-radius: 2px;
  }

  .checkbox-input:checked {
    background: white;
    position: relative;
  }

  .checkbox-input:checked::after {
    content: "✓";
    position: absolute;
    top: -2px;
    left: 2px;
    color: #0c1b3a;
    font-size: 12px;
    font-weight: bold;
  }

  .checkbox-text {
    color: white;
    font-size: 0.9rem;
  }

  .submit-button {
    background: #0c1b3a;
    color: white;
    border: 1px solid white;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .submit-button:hover {
    background: white;
    color: #0c1b3a;
  }

  .privacy-text {
    color: white;
    font-size: 0.8rem;
    line-height: 1.4;
    opacity: 0.8;
    margin: 1rem 0 0 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column;
      gap: 1rem;
    }

    .hero-title {
      font-size: 3rem;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .container {
      padding: 0 1rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .newsletter-section {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .section-heading {
      font-size: 1.3rem;
    }

    .action-item {
      font-size: 1.1rem;
    }
  }
</style>
