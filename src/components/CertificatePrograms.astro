---
import Layout from './Layout.astro';

interface Props {
  hero: {
    title?: string;
    subtitle?: string;
    image?: string;
  } | null | undefined;
  contentBlocks: any[];
}

const { hero, contentBlocks } = Astro.props;
---

<section class="certificate-programs-page">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">CERTIFICATE PROGRAMS</h1>
      <div class="hero-subtitle">
        <p><strong>At the New England Complex Systems Institute (NECSI), we offer certificate programs that equip learners with the tools to understand and navigate today's most complex challenges using systems thinking and real-world application.</strong></p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="main-content">
    <div class="content-container">
      
      <!-- Who It's For Section -->
      <div class="content-section">
        <h2 class="section-heading">Who It's For</h2>
        <p class="section-text">Policymakers, scientists, educators, business leaders, students — anyone ready to work across disciplines and scale their impact.</p>
      </div>

      <!-- Enrollment Details Section -->
      <div class="content-section">
        <h2 class="section-heading">Enrollment Details</h2>
        <ul class="enrollment-list">
          <li><strong>Year-round, rolling admission</strong></li>
          <li><strong>Live & recorded sessions</strong> for flexible access</li>
          <li><strong>No prerequisites</strong> — open to all learners</li>
          <li><strong>Scholarships available</strong> based on merit and need</li>
        </ul>
      </div>

      <!-- Get Notified Section -->
      <div class="content-section notification-section">
        <div class="notification-content">
          <p class="notification-text">Get Notified When Enrollment Opens</p>
        </div>
      </div>

    </div>
  </section>
</section>

<style>
  .certificate-programs-page {
    min-height: 100vh;
    background: #ffffff;
    color: #333333;
  }

  /* Hero Section */
  .hero-section {
    background: #0c1b3a;
    color: white;
    padding: 4rem 0;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    font-weight: 400;
  }

  .hero-subtitle p {
    margin: 0;
  }

  /* Main Content */
  .main-content {
    padding: 4rem 0;
  }

  .content-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .content-section {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 600;
    color: #333333;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .section-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #333333;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .enrollment-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .enrollment-list li {
    font-size: 1rem;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .enrollment-list li::before {
    content: "•";
    color: #333333;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  /* Notification Section */
  .notification-section {
    text-align: center;
    margin-top: 4rem;
  }

  .notification-content {
    background: #f8f9fa;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    padding: 2rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .notification-text {
    font-size: 1rem;
    font-weight: 600;
    color: #333333;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .hero-content,
    .content-container {
      padding: 0 1rem;
    }

    .main-content {
      padding: 3rem 0;
    }

    .content-section {
      margin-bottom: 2rem;
    }

    .section-heading {
      font-size: 1.3rem;
    }

    .notification-content {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 3rem 0;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .main-content {
      padding: 2rem 0;
    }
  }
</style>
