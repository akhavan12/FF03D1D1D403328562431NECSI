---
export interface Props {
  contentBlocks: Array<{
    heading: string | null;
    text: string | null;
  }>;
}

const { contentBlocks } = Astro.props;
---

<section class="content-blocks">
  <div class="container">
    {contentBlocks.map((block) => (
      <div class="content-block">
        {block.heading && (
          <h2 class="block-heading">{block.heading}</h2>
        )}
        {block.text && (
          <div class="block-text" set:html={block.text} />
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .content-blocks {
    padding: 2rem 0;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .content-block {
    margin-bottom: 2.5rem;
  }
  
  .block-heading {
    color: #333333;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .block-text {
    color: #333333;
    line-height: 1.6;
    font-size: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  
  .block-text p {
    margin-bottom: 1rem;
  }
  
  .block-text p:last-child {
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .content-blocks {
      padding: 1.5rem 0;
      max-width: 100%;
    }
    
    .content-block {
      margin-bottom: 2rem;
    }
    
    .block-heading {
      font-size: 1rem;
    }
    
    .block-text {
      font-size: 0.95rem;
    }
  }
</style>
