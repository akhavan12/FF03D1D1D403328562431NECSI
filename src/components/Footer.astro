---
export interface Props {
  footerLinks: Array<{
    label: string;
    href: string;
  }>;
}

const { footerLinks } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>New England Complex Systems Institute</h3>
        <p>Advancing Knowledge Through Complexity Science</p>
      </div>
      
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul class="footer-links">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="footer-section">
        <h4>Contact</h4>
        <p>Phone: (617) 547-4100</p>
        <p>Email: programs@necsi.edu</p>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; 2024 New England Complex Systems Institute. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #2c3e50;
    color: white;
    padding: 3rem 0 1rem;
    margin-top: 4rem;
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }
  
  .footer-section h3 {
    color: #3498db;
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }
  
  .footer-section h4 {
    color: #ecf0f1;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  
  .footer-section p {
    color: #bdc3c7;
    margin-bottom: 0.5rem;
  }
  
  .footer-links {
    list-style: none;
    padding: 0;
  }
  
  .footer-links li {
    margin-bottom: 0.5rem;
  }
  
  .footer-link {
    color: #bdc3c7;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .footer-link:hover {
    color: #3498db;
    text-decoration: none;
  }
  
  .footer-bottom {
    border-top: 1px solid #34495e;
    padding-top: 1rem;
    text-align: center;
  }
  
  .footer-bottom p {
    color: #95a5a6;
    font-size: 0.9rem;
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0 1rem;
    }
    
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
