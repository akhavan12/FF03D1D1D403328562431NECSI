---
const { title = 'NECSI', description = '' } = Astro.props as { title?: string; description?: string };
import '../styles/tailwind.css';

const baseUrl = '/FF03D1D1D403328562431NECSI/';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="New England Complex Systems Institute - Advancing Knowledge Through Complexity Science" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <!-- Header -->
    <header class="bg-slate-900 text-white shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
          <!-- Logo -->
          <div class="flex-shrink-0">
            <a href={baseUrl} class="text-2xl font-bold text-white hover:text-slate-200 transition-colors">
              New England Complex Systems Institute
            </a>
          </div>
          
          <!-- Desktop Navigation -->
          <nav class="hidden md:flex space-x-8">
            <a href={baseUrl} class="text-white hover:text-slate-200 px-3 py-2 text-sm font-medium transition-colors">Home</a>
            <a href={`${baseUrl}about`} class="text-white hover:text-slate-200 px-3 py-2 text-sm font-medium transition-colors">About</a>
            <a href={`${baseUrl}research`} class="text-white hover:text-slate-200 px-3 py-2 text-sm font-medium transition-colors">Research</a>
            <a href={`${baseUrl}research/engage`} class="text-white hover:text-slate-200 px-3 py-2 text-sm font-medium transition-colors">Engage</a>
            <a href={`${baseUrl}research/compassionate-science`} class="text-white hover:text-slate-200 px-3 py-2 text-sm font-medium transition-colors">Compassionate Science</a>
          </nav>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button type="button" class="text-white hover:text-slate-200 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-900" id="mobile-menu-button">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Navigation -->
      <div class="md:hidden hidden" id="mobile-menu">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-slate-800">
          <a href={baseUrl} class="text-white hover:text-slate-200 block px-3 py-2 text-base font-medium">Home</a>
          <a href={`${baseUrl}about`} class="text-white hover:text-slate-200 block px-3 py-2 text-base font-medium">About</a>
          <a href={`${baseUrl}research`} class="text-white hover:text-slate-200 block px-3 py-2 text-base font-medium">Research</a>
          <a href={`${baseUrl}research/engage`} class="text-white hover:text-slate-200 block px-3 py-2 text-base font-medium">Engage</a>
          <a href={`${baseUrl}research/compassionate-science`} class="text-white hover:text-slate-200 block px-3 py-2 text-base font-medium">Compassionate Science</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- About -->
          <div>
            <h3 class="text-lg font-semibold mb-4">About NECSI</h3>
            <p class="text-slate-300 text-sm">
              The New England Complex Systems Institute advances knowledge through complexity science, 
              using next-generation mathematics to understand dynamic, interconnected systems.
            </p>
          </div>
          
          <!-- Research -->
          <div>
            <h3 class="text-lg font-semibold mb-4">Research</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={`${baseUrl}research`} class="text-slate-300 hover:text-white transition-colors">All Research</a></li>
              <li><a href={`${baseUrl}research/recent-papers`} class="text-slate-300 hover:text-white transition-colors">Recent Papers</a></li>
              <li><a href={`${baseUrl}research/faculty`} class="text-slate-300 hover:text-white transition-colors">Faculty</a></li>
            </ul>
          </div>
          
          <!-- Education -->
          <div>
            <h3 class="text-lg font-semibold mb-4">Education</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={`${baseUrl}research/certificateprograms`} class="text-slate-300 hover:text-white transition-colors">Certificate Programs</a></li>
              <li><a href={`${baseUrl}research/concepts-and-applications-of-complexity-science`} class="text-slate-300 hover:text-white transition-colors">Courses</a></li>
              <li><a href={`${baseUrl}research/student-opportunities`} class="text-slate-300 hover:text-white transition-colors">Student Opportunities</a></li>
            </ul>
          </div>
          
          <!-- Connect -->
          <div>
            <h3 class="text-lg font-semibold mb-4">Connect</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={`${baseUrl}research/support`} class="text-slate-300 hover:text-white transition-colors">Support</a></li>
              <li><a href={`${baseUrl}research/google-search`} class="text-slate-300 hover:text-white transition-colors">Search</a></li>
              <li><a href="https://twitter.com/necsi" class="text-slate-300 hover:text-white transition-colors">Twitter</a></li>
            </ul>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-slate-700">
          <div class="flex flex-col md:flex-row justify-between items-center">
            <p class="text-slate-400 text-sm">
              © {new Date().getFullYear()} New England Complex Systems Institute. All rights reserved.
            </p>
            <p class="text-slate-400 text-sm mt-2 md:mt-0">
              Advancing Knowledge Through Complexity Science
            </p>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu script -->
    <script>
      document.getElementById('mobile-menu-button')?.addEventListener('click', function() {
        const menu = document.getElementById('mobile-menu');
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
