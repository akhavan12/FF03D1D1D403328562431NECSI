---
export interface Props {
  hero?: {
    subtitle?: string;
  };
}

const { hero } = Astro.props;

const defaultSubtitle = 'Complex systems science changes the way we think about science and its role in society. It goes beyond the traditional, reductionist approach of focusing on the parts of a system, to integrating the network of relationships within and between systems.';
const defaultDescription = 'NECSI research addresses the challenges of complexity across many domains, from healthcare and economics to social systems and evolution.';
---

<section class="hero-description">
  <div class="container">
    <div class="description-content">
      <p class="description-text">{hero?.subtitle || defaultSubtitle}</p>
      <p class="description-text">{defaultDescription}</p>
    </div>
  </div>
</section>

<style>
  .hero-description {
    background: #ffffff;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .description-content {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .description-text {
    color: #333333;
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 300;
  }
  
  .description-text:last-child {
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .hero-description {
      padding: 1.5rem 0;
    }
    
    .container {
      padding: 0 1rem;
    }
    
    .description-text {
      font-size: 1rem;
      line-height: 1.6;
      margin: 0 0 1.25rem 0;
    }
  }
  
  @media (max-width: 480px) {
    .hero-description {
      padding: 1.25rem 0;
    }
    
    .description-text {
      font-size: 0.95rem;
    }
  }
</style>
