---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDocBySlug } from '../lib/content';
import { mdToHtml } from '../lib/markdown';

const doc = await getDocBySlug('about');
---

<style is:global>
  /* Make header transparent over the hero for About */
  header {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-color: transparent !important;
  }
  header a { color: white !important; }
  header a:hover { color: #e2e8f0 !important; }
</style>

<BaseLayout title={`${doc.title} — NECSI`}>
  <!-- Hero -->
  <section class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen -mt-24 -mb-px">
    <div class="relative">
      {doc.hero_image && (
        <img src={doc.hero_image} alt="" class="absolute inset-0 h-full w-full object-cover" />
      )}
      <div class={`relative ${doc.hero_image ? 'bg-transparent' : 'bg-gradient-to-b from-slate-800 to-slate-700'}`}>
        <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 sm:py-28">
          <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-white">{doc.title}</h1>
          {doc.subtitle && (
            <p class="mt-3 text-slate-200 text-lg max-w-3xl">{doc.subtitle}</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Panels -->
  <div class="space-y-16 py-8">
    {doc.panels?.map((p: any) => (
      <section class="max-w-6xl mx-auto px-6">
        {/* Image + Text (image left/right) */}
        {p.type === 'image-text' || p.type === 'text-image' ? (
          <div class={`grid grid-cols-1 md:grid-cols-12 gap-8 items-center`}>
            <div class={(p.type === 'image-text' ? 'md:col-span-5 order-1' : 'md:col-span-5 md:order-2') + ' order-1'}>
              {p.media?.image && (<img src={p.media.image} alt={p.media.alt || ''} class="w-full rounded" />)}
            </div>
            <div class={(p.type === 'image-text' ? 'md:col-span-7 order-2' : 'md:col-span-7 md:order-1') + ' order-2'}>
              {p.title && (<h2 class="text-2xl font-semibold mb-2">{p.title}</h2>)}
              <div class="prose prose-slate max-w-none" set:html={mdToHtml(p.body_md || '')} />
              {p.buttons?.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-3">
                  {p.buttons.map((b:any) => (
                    <a href={b.url} class="inline-block rounded-full bg-sky-700 px-4 py-2 text-white hover:bg-sky-800">{b.label}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ) : p.media?.image && p.type === 'image' && (p.body_md || p.title) ? (
          // Image and text stacked on small screens
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
            <div class="md:col-span-4">
              <img src={p.media.image} alt={p.media.alt || ''} class="w-full rounded" />
            </div>
            <div class="md:col-span-8">
              {p.title && (<h2 class="text-2xl font-semibold mb-2">{p.title}</h2>)}
              <div class="prose prose-slate max-w-none" set:html={mdToHtml(p.body_md || '')} />
              {p.buttons?.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-3">
                  {p.buttons.map((b:any) => (
                    <a href={b.url} class="inline-block rounded-full bg-sky-700 px-4 py-2 text-white hover:bg-sky-800">{b.label}</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ) : (
          // Default text panel
          <div>
            {p.title && (<h2 class="text-2xl font-semibold mb-2">{p.title}</h2>)}
            <div class="prose prose-slate max-w-none" set:html={mdToHtml(p.body_md || '')} />
            {p.buttons?.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-3">
                {p.buttons.map((b:any) => (
                  <a href={b.url} class="inline-block rounded-full bg-sky-700 px-4 py-2 text-white hover:bg-sky-800">{b.label}</a>
                ))}
              </div>
            )}
          </div>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
